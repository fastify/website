---
import BenchBars from "~/components/BenchBars.astro";
import ButtonLink from "~/components/ButtonLink.astro";
import BenchStat from "~/components/benchmarks/BenchStat.astro";
import Icon from "~/components/Icon.astro";
import PageHeader from "~/components/PageHeader.astro";
import { BENCHMARK_STATS } from "~/data/site";
import BaseLayout from "~/layouts/BaseLayout.astro";

const {
	self: fastify,
	multiplier,
	latencyMultiplier,
	throughputMultiplier,
} = BENCHMARK_STATS;

const lastUpdated = (
	Number.isNaN(Date.parse(BENCHMARK_STATS.date))
		? new Date()
		: new Date(BENCHMARK_STATS.date)
).toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<BaseLayout
  title="Benchmarks — Fastify"
  description="How Fastify compares to other Node.js web frameworks on throughput."
>
  <PageHeader eyebrow="// benchmarks" title="Benchmarks">
    Machines matter, but so does the framework overhead. Fastify was
    engineered from the ground up to add as little as possible on top of
    Node.js.
  </PageHeader>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 2xl:max-w-[100rem]">
    <div class="space-y-8">
      <div class="card p-6 sm:p-10">
        <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-0">
          <h2 class="font-display text-2xl font-semibold">Requests per second</h2>
          <span class="font-mono text-xs text-muted"
            >Node.js · single instance · updated {lastUpdated}</span
          >
        </div>
        <BenchStat value={fastify.reqs} unit="req/s" multiplier={multiplier} comparison="faster than Express" />
        <BenchBars valueKey="reqs" unit="req/s" betterIs="higher" decimals={0} />
      </div>
      <div class="card p-6 sm:p-10">
        <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-0">
          <h2 class="font-display text-2xl font-semibold">Latency</h2>
          <span class="font-mono text-xs text-muted"
            >Node.js · single instance · updated {lastUpdated}</span
          >
        </div>
        <BenchStat value={fastify.latency} unit="ms" multiplier={latencyMultiplier} comparison="lower than Express" decimals={2} />
        <BenchBars valueKey="latency" unit="ms" betterIs="lower" decimals={2} />
      </div>
      <div class="card p-6 sm:p-10">
        <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-0">
          <h2 class="font-display text-2xl font-semibold">Throughput</h2>
          <span class="font-mono text-xs text-muted"
            >Node.js · single instance · updated {lastUpdated}</span
          >
        </div>
        <BenchStat value={fastify.throughput} unit="MB/s" multiplier={throughputMultiplier} comparison="faster than Express" decimals={2} />
        <BenchBars valueKey="throughput" unit="MB/s" betterIs="higher" decimals={2} />
      </div>
    </div>

    <div
      class="mt-8 rounded-xl border border-border bg-surface/40 p-6 text-sm leading-relaxed text-fg-soft"
    >
      <div class="flex items-start gap-3">
        <span class="mt-0.5 text-amber-ink"
          ><Icon name="schema" size={18} /></span
        >
        <p>
          These figures are <strong class="text-fg">illustrative</strong>.
          Real-world results depend on your hardware, Node.js version, and
          workload. Reproduce them yourself with the official{" "}
          <a
            href="https://github.com/fastify/benchmarks"
            target="_blank"
            rel="noopener noreferrer"
            class="text-amber-ink underline decoration-border-strong underline-offset-2"
            >fastify/benchmarks</a
          >
          {" "}suite and measure against your own routes.
        </p>
      </div>
    </div>

    <div class="mt-8">
      <ButtonLink href="https://github.com/fastify/benchmarks" external>
        <Icon name="github" size={18} /> Run the benchmark suite
      </ButtonLink>
    </div>
  </section>
</BaseLayout>
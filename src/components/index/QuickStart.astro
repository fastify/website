---
import CodeTabs from "~/components/CodeTabs.astro";
import Icon from "~/components/Icon.astro";
import InstallCommand from "~/components/InstallCommand.astro";
import { withBase } from "~/lib/href";

const typescriptCode = `import Fastify from 'fastify'
import { Type } from 'typebox'
import type { TypeBoxTypeProvider } from '@fastify/type-provider-typebox'

const fastify = Fastify({ logger: true })
  .withTypeProvider<TypeBoxTypeProvider>()

fastify.get('/', {
  schema: {
    querystring: Type.Object({
      name: Type.Optional(Type.String()),
    }),
    response: {
      200: Type.Object({
        hello: Type.String(),
      }),
    },
  },
}, async (request) => {
  return { hello: request.query.name ?? 'world' }
})

await fastify.listen({ port: 3000 })`;
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 2xl:max-w-[100rem]">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
    <div class="lg:sticky lg:top-24">
      <p class="eyebrow">// quick start</p>
      <h2
        class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Type-safe from the start
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-fg-soft">
        Install Fastify and TypeBox, then create <code
          class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-sm text-amber-ink"
          >server.ts</code
        >. The same schema validates incoming data, serializes the response,
        and infers the request type for your handler.
      </p>
      <div class="mt-6">
        <InstallCommand
          command="npm install fastify @fastify/type-provider-typebox typebox"
        />
      </div>
      <a
        href={withBase("/docs/latest")}
        class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-amber-ink hover:underline"
      >
        Explore the full documentation <Icon name="arrow" size={16} />
      </a>
    </div>

    <div class="min-w-0">
      <CodeTabs
        id="hello"
        title="Type-safe hello world server"
        tabs={[{ label: "server.ts", lang: "ts", code: typescriptCode }]}
      />
    </div>
  </div>
</section>
